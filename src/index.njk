---
layout: base.njk
title: Matt Hovis
navPage: home
permalink: /
---

  <!-- Hero -->
  <header class="hero">
    <div class="hero-content">
      <p class="hero-eyebrow">Hi, I'm</p>
      <h1 class="hero-name">Matt Hovis</h1>
      <p class="hero-role">Business Analyst</p>
      <p class="hero-tagline">
        I turn ambiguous requests into clear requirements, validated fixes, and measurable outcomes across enterprise SaaS operations.
      </p>
      <ul class="hero-proof" aria-label="Professional credibility highlights">
        <li>11+ years in operations and analysis</li>
        <li>SQL certified</li>
        <li>Atlassian certified (Jira and Confluence)</li>
        <li>Enterprise SaaS and service workflows</li>
      </ul>
      <ul class="hero-chips" aria-label="Key skills">
        <li>Business Analysis</li>
        <li>SQL Root Cause Analysis</li>
        <li>Cross-Functional Delivery</li>
      </ul>
      <div class="hero-cta-group">
        <a href="#work" class="btn-primary">View Work</a>
        <a href="#contact" class="btn-outline">Get in Touch</a>
      </div>
    </div>
    <div class="hero-decoration" aria-hidden="true">
      <div class="deco-ring deco-ring--1"></div>
      <div class="deco-ring deco-ring--2"></div>
      <div class="deco-ring deco-ring--3"></div>
    </div>
  </header>

  <!-- Work -->
  <section id="work" class="section section--alt">
    <div class="container">
      <h2 class="section-title">Selected work</h2>
      <p class="section-subtitle">A few examples of the kind of problems I solve and how I approach them.</p>

      <div class="work-grid">
        {% for item in work %}
        <a href="/work/{{ item.slug }}/" class="work-card-link">
          <article class="work-card work-card--{{ item.cardNumber }}">
            <h3 class="work-card__title">{{ item.title }}</h3>
            <p class="work-card__meta-line" aria-label="Project quick facts">
              <span>{{ item.role }}</span>
              <span>{{ item.timeframe }}</span>
            </p>
            <p class="work-card__metric"><strong>Impact:</strong> {{ item.metric }}</p>
            <p class="work-card__body">{{ item.shortDesc }}</p>
            <div class="work-card__highlights">
              <p>{{ item.focus }}</p>
              <p>{{ item.proof }}</p>
            </div>
            <span class="work-card__cta">Read more →</span>
          </article>
        </a>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="section">
    <div class="container">
      <h2 class="section-title">About</h2>
      <div class="about-grid">
        <div class="about-text">
          <p>
            I'm a business analyst focused on enterprise SaaS and service operations. I translate operational ambiguity
            into requirements teams can build, test, and release with confidence.
          </p>
          <p>
            My approach combines discovery, SQL validation, and engineering collaboration to move from issue discovery to
            measurable outcomes, including faster defect resolution and cleaner cross-team handoffs.
          </p>
        </div>
        <div class="about-cards">
          <div class="stat-card">
            <span class="stat-icon">&#128202;</span>
            <span class="stat-label">What I do</span>
            <span class="stat-detail">Business analysis, workflow design, production defect resolution</span>
          </div>
          <div class="stat-card">
            <span class="stat-icon">&#128295;</span>
            <span class="stat-label">Tools</span>
            <span class="stat-detail">SQL, Jira, Confluence, GitHub Copilot, Codex, Claude, Gemini</span>
          </div>
          <div class="stat-card">
            <span class="stat-icon">&#9889;</span>
            <span class="stat-label">Strengths</span>
            <span class="stat-detail">Problem solving, cross-functional delivery, AI-assisted programming</span>
          </div>
          <div class="stat-card">
            <span class="stat-icon">&#127970;</span>
            <span class="stat-label">Domain</span>
            <span class="stat-detail">Enterprise SaaS, retail/service operations, payments, scheduling</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interests -->
  <section id="interests" class="section section--alt">
    <div class="container">
      <h2 class="section-title">Interests</h2>
      <p class="section-subtitle">A few of the things that keep life interesting.</p>

      <div class="interests-grid">

        <!-- Video Games -->
        <div class="interest-card interest-card--games">
          <div class="interest-card__header">
            <div class="interest-icon">&#127918;</div>
            <h3>Video Games</h3>
          </div>
          <p>
            I'm here for strong systems and good stories. I like digging into why games work, not just finishing them.
          </p>
          <ul class="interest-tags">
            <li>RPGs</li>
            <li>Retro Games</li>
            <li>Game Design</li>
          </ul>
        </div>

        <!-- Comics & Manga -->
        <div class="interest-card interest-card--comics">
          <div class="interest-card__header">
            <div class="interest-icon">&#128214;</div>
            <h3>Comics &amp; Manga</h3>
          </div>
          <p>
            I read across superhero, indie, and slice-of-life. Sequential art is my favorite storytelling format.
          </p>
          <ul class="interest-tags">
            <li>Manga</li>
            <li>Superhero</li>
            <li>Indie Comics</li>
          </ul>
        </div>

        <!-- Gunpla -->
        <div class="interest-card interest-card--gunpla">
          <div class="interest-card__header">
            <div class="interest-icon">&#9881;</div>
            <h3>Gunpla</h3>
          </div>
          <p>
            Hands-on, detail-focused, and relaxing. I'm always improving cleanup, panel lining, and display builds.
          </p>
          <ul class="interest-tags">
            <li>Gundam</li>
            <li>Panel Lining</li>
            <li>Display Builds</li>
          </ul>
          <div class="gunpla-photo-container">
            <img src="gunpla.jpg" alt="Gunpla model build" class="gunpla-photo">
          </div>
        </div>

        <!-- Atlanta Braves -->
        <div class="interest-card interest-card--braves">
          <div class="interest-card__header">
            <div class="interest-icon">&#9918;</div>
            <h3>Atlanta Braves</h3>
          </div>
          <p>
            Lifelong fan. I'm happy watching a random Tuesday game as much as a playoff run.
          </p>
          <ul class="interest-tags">
            <li>Atlanta Braves</li>
            <li>MLB</li>
            <li>Baseball</li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section">
    <div class="container container--narrow">
      <h2 class="section-title">Get in touch</h2>
      <p class="section-subtitle">
        Want to connect? If it's about analytics work, collaboration, or even swapping game recs, I'm easy to reach.
      </p>
      <div class="contact-actions">
        <a href="mailto:matt.hovis@icloud.com" class="btn-primary">Email me</a>
        <a href="https://www.linkedin.com/in/matthewkhovis" class="btn-outline" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com/MattOverbored" class="btn-outline" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </section>
