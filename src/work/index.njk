---
layout: base.njk
pagination:
  data: work
  size: 1
  alias: workItem
permalink: /work/{{ workItem.slug }}/index.html
---

<article class="work-detail">
  <div class="container">
    <div class="work-detail__header">
      <a href="/#work" class="work-detail__back">&larr; Back to work</a>
      <h1 class="work-detail__title">{{ workItem.title }}</h1>
      <p class="work-detail__context">{{ workItem.context }}</p>
    </div>

    <div class="work-detail__grid">
      <!-- Main Content -->
      <div class="work-detail__main">
        <section class="work-detail__section">
          <h2 class="work-detail__heading">The Challenge</h2>
          <p class="work-detail__text">{{ workItem.problem }}</p>
        </section>

        <section class="work-detail__section">
          <h2 class="work-detail__heading">The Solution</h2>
          <p class="work-detail__text">{{ workItem.solution }}</p>
        </section>

        <section class="work-detail__section">
          <h2 class="work-detail__heading">Details</h2>
          <p class="work-detail__text">{{ workItem.details }}</p>
        </section>

        <section class="work-detail__section">
          <h2 class="work-detail__heading">The Impact</h2>
          <ul class="work-detail__impact-list">
            {% for item in workItem.impact %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </section>
      </div>

      <!-- Sidebar -->
      <aside class="work-detail__sidebar">
        <div class="work-detail__card">
          <h3 class="work-detail__card-heading">Outcome</h3>
          <p class="work-detail__card-text">{{ workItem.outcome }}</p>
        </div>

        <div class="work-detail__card">
          <h3 class="work-detail__card-heading">Tools &amp; Skills</h3>
          <div class="work-detail__tags">
            {% for tool in workItem.tools %}
            <span class="work-detail__tag">{{ tool }}</span>
            {% endfor %}
          </div>
        </div>
      </aside>
    </div>

    <div class="work-detail__footer">
      <a href="/#work" class="btn-primary">Back to all work</a>
    </div>
  </div>
</article>
